# Copy to .env.local for local development (`pnpm start:local`), or to .env
# for `docker compose --profile app up`.

# PostgreSQL. Migrations run automatically when the app boots.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dialogue_dev
# Optional pool tuning per app process.
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=10000

# Any OpenAI-compatible endpoint serving Apertus, WITHOUT the trailing /v1
# (the app calls $LLM_BASE_URL/v1/chat/completions).
LLM_BASE_URL=https://your-llm-endpoint.example.com
LLM_API_KEY=
# Model id as your endpoint names it.
LLM_MODEL=apertus-ai/Apertus-v1.5-70B-integration

# HTTP Basic auth password for /admin (any username). If unset, /admin is
# only reachable from localhost in development and is locked in production.
ADMIN_PASSWORD=

# /partner: a browser admin for collaborators, signed in with named access
# keys created at /admin → Access. Both values must be set or partner login
# is disabled. Use a long random secret, e.g. `openssl rand -hex 32`.
PARTNER_SESSION_SECRET=change-me-to-a-long-random-string-32-bytes-min
PARTNER_ADMIN_SLUG=swiss-national-ai-dialogue

# Optional Amplitude product analytics (only loaded after cookie consent).
# Leave empty to disable.
NEXT_PUBLIC_AMPLITUDE_ID=

# Optional: extra hostnames allowed to post server actions when a proxy
# rewrites the Host header, comma-separated.
# SERVER_ACTIONS_ALLOWED_ORIGINS=dialogue.example.com
