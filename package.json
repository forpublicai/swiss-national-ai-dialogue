{
  "name": "swiss-national-ai-dialogue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "start:local": "pnpm dev:db && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "test:integration": "jest --config jest.config.ts",
    "test:e2e": "playwright test",
    "eval:interviews": "tsx --env-file=.env.local ./scripts/contribution-interview-eval/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev:db": "docker compose up -d && DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dialogue_dev pnpm db:migrate",
    "dev:db:down": "docker compose down",
    "dev:db:reset": "docker compose down -v && pnpm dev:db"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.27.0",
    "@amplitude/engagement-browser": "^1.0.6",
    "@amplitude/plugin-session-replay-browser": "^1.23.6",
    "@fontsource/commissioner": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.454.0",
    "motion": "^12.38.0",
    "next": "15.5.23",
    "pg": "^8.16.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30",
    "tailwindcss": "^4.1.9",
    "ts-jest": "^29.3.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.3.3",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.4"
}
